# Copy this file to .env and fill in your own credentials.
# Never commit the resulting .env file.

# OpenAI Configuration
USE_OPENAI_API_KEY="True"

OPENAI_API_KEY=""
OPENAI_MODEL_NAME=""

# Azure OpenAI Configuration (used when USE_OPENAI_API_KEY="False")
OPENAI_API_VERSION=""
AZURE_OPENAI_ENDPOINT=""
AZURE_OPENAI_DEPLOYMENT_NAME=""

# Gemini Configuration (used automatically whenever a call passes a model_name
# starting with "gemini", e.g. for cross-model generalization experiments)
GEMINI_API_KEY=""

# Local open-weight model (vLLM OpenAI-compatible server). When
# LOCAL_OPENAI_BASE_URL is set, it takes priority over every closed-model
# path above -- this is the rebuild's inference target. See HANDOFF-GPU.md.
LOCAL_OPENAI_BASE_URL=""
LOCAL_MODEL_NAME=""
